generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

enum SearchStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
  NEEDS_INFO
}

enum HoldStatus {
  HELD
  CHARGED
  RELEASED
}

enum WhySource {
  TEMPLATE
  AI
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum AiProvider {
  OPENAI
  GROQ
  GEMINI
  CLAUDE
  HEURISTIC
}

model User {
  id               String    @id @default(cuid())
  clerkId          String    @unique
  email            String    @unique
  name             String?
  role             UserRole  @default(USER)
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  subscription  Subscription?
  leadContext   UserLeadContext?
  usageRecords  UsageRecord[]
  leadSearches  LeadSearch[]
  leads         Lead[]
  savedLists    SavedLeadList[]
  apiKeyConfigs ApiKeyConfig[]
  exportLogs    ExportLog[]
  creditHolds   CreditHold[]

  @@index([clerkId])
  @@index([email])
  @@index([stripeCustomerId])
}

model UserLeadContext {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  companyName            String?
  websiteUrl             String?
  businessDescription    String?
  targetMarket           String?
  mainOffer              String?
  targetIndustries       Json     @default("[]")
  targetCountries        Json     @default("[]")
  companySizeMin         Int?
  companySizeMax         Int?
  targetTitles           Json     @default("[]")
  targetSeniorities      Json     @default("[]")
  excludedIndustries     Json     @default("[]")
  excludedTitles         Json     @default("[]")
  preferredBuyingSignals Json     @default("[]")
  highQualityLeadNotes   String?
  badLeadNotes           String?
  preferredOutreachAngle String?
  servicesToSell         Json     @default("[]")
  minLeadScore           Int      @default(8)
  onboardingCompleted    Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Plan {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  stripePriceId    String?  @unique
  leadsPerMonth    Int
  searchesPerMonth Int
  features         Json
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  planId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  planName             String?
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([stripeCustomerId])
  @@index([status])
}

model StripeEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model UsageRecord {
  id           String   @id @default(cuid())
  userId       String
  /// timestamp WITHOUT time zone. A JS Date binds as timestamptz in raw SQL and
  /// is shifted by the session offset, so `WHERE "periodStart" = ${date}` in
  /// Prisma.sql matches ZERO rows. Query this column through the Prisma client,
  /// or look the row up first and use its `id` in raw SQL.
  periodStart  DateTime
  periodEnd    DateTime
  leadsUsed    Int      @default(0)
  searchesUsed Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([userId, periodStart])
}

model LeadSearch {
  id             String       @id @default(cuid())
  userId         String
  prompt         String
  inputType      String       @default("prompt")
  status         SearchStatus @default(PENDING)
  parsedCriteria Json?
  apolloFilters  Json?
  relaxNote      String?
  totalAvailable Int?
  leadsReturned  Int          @default(0)
  errorMessage   String?
  aiProviderUsed AiProvider?
  durationMs     Int?
  // Brief the AI produced once; every batch re-queries from this, never re-parses.
  brief          Json?
  questions      Json?
  answers        Json?
  nextPage       Int          @default(1)
  batchesDone    Int          @default(0)
  totalPages     Int?
  statusNote     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads       Lead[]
  creditHolds CreditHold[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

/// Credits are deducted before paid work, then charged for what was delivered
/// or released. Every exit path from a batch must settle its hold.
model CreditHold {
  id             String     @id @default(cuid())
  userId         String
  searchId       String
  amount         Int
  charged        Int?
  status         HoldStatus @default(HELD)
  /// "{searchId}:{batchNo}" — the unique constraint is what stops a
  /// double-clicked button reserving twice.
  idempotencyKey String     @unique
  /// A refund must return to the UsageRecord it came from, even if the billing
  /// period rolls over mid-batch.
  periodStart    DateTime
  createdAt      DateTime   @default(now())
  settledAt      DateTime?

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  search LeadSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}

model Lead {
  id                  String        @id @default(cuid())
  userId              String
  searchId            String
  apolloPersonId      String?
  name                String
  title               String
  company             String
  industry            String?
  employees           Int?
  location            String?
  email               String?
  // Provider email confidence: "verified", "guessed", or null when unknown.
  emailStatus         String?
  whySource           WhySource     @default(TEMPLATE)
  linkedinUrl         String?
  leadScore           Int
  priorityLevel       PriorityLevel
  reasoning           String?
  recommendedApproach String?
  hasEmail            Boolean       @default(false)
  rawApolloData       Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  search    LeadSearch          @relation(fields: [searchId], references: [id], onDelete: Cascade)
  listItems SavedLeadListItem[]

  @@index([userId, leadScore(sort: Desc)])
  @@index([searchId])
  @@index([email])
}

/// One row per real person, shared by every search. Searches read from here
/// first and only go to Apollo for what is missing, so a person found or
/// unlocked once is never paid for twice.
model LeadPoolPerson {
  id               String    @id @default(cuid())
  apolloPersonId   String?   @unique
  /// Normalized: https, no "www.", no query string, no trailing slash.
  linkedinUrl      String?   @unique
  name             String
  title            String
  /// Lowercase, singular, punctuation-free title used for matching.
  titleNormalized  String
  headline         String?
  company          String?
  industry         String?
  employees        Int?
  city             String?
  state            String?
  country          String?
  /// Lowercase "city, state, country" plus any free-text location, for matching.
  locationText     String    @default("")
  email            String?
  /// Provider email confidence: "verified", "guessed", or null when unknown.
  emailStatus      String?
  /// Set when Apollo was asked for an email, whether or not it returned one.
  emailCheckedAt   DateTime?
  openToWorkSignal String?
  /// Where this person came from, e.g. "apollo_search", "apollo_enrich", "serper".
  sources          String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([titleNormalized])
  @@index([country])
}

model SavedLeadList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedLeadListItem[]

  @@index([userId])
}

model SavedLeadListItem {
  id     String @id @default(cuid())
  listId String
  leadId String

  list SavedLeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  lead Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([listId, leadId])
}

model ApiKeyConfig {
  id           String   @id @default(cuid())
  userId       String?
  provider     String
  encryptedKey String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model AiProviderLog {
  id           String     @id @default(cuid())
  userId       String?
  searchId     String?
  provider     AiProvider
  operation    String
  success      Boolean
  latencyMs    Int?
  errorMessage String?
  createdAt    DateTime   @default(now())

  @@index([provider, createdAt(sort: Desc)])
  @@index([searchId])
}

model ApolloApiLog {
  id           String   @id @default(cuid())
  userId       String?
  searchId     String?
  endpoint     String
  statusCode   Int?
  resultCount  Int?
  relaxLevel   Int?
  latencyMs    Int?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model ExportLog {
  id        String   @id @default(cuid())
  userId    String
  searchId  String?
  format    String
  leadCount Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt(sort: Desc)])
}
