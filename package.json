{
  "name": "cludly",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "bash scripts/dev-clean.sh",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "pool:import": "tsx scripts/import-lead-pool.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:up": "bash scripts/docker-db.sh up",
    "db:down": "bash scripts/docker-db.sh down",
    "db:reset": "bash scripts/docker-db.sh reset",
    "db:logs": "bash scripts/docker-db.sh logs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.3",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.511.0",
    "next": "^15.5.27",
    "openai": "^4.104.0",
    "playwright": "^1.63.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^22.2.1",
    "svix": "^1.95.2",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.19.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.4",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
