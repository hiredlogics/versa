# Docker PostgreSQL — copy values into .env.local
# Host port 5434 avoids conflict with local Postgres (5432) and other Docker DBs (5433)

POSTGRES_USER=leadpilot
POSTGRES_PASSWORD=leadpilot
POSTGRES_DB=leadpilot
POSTGRES_HOST_PORT=5434

DATABASE_URL=postgresql://leadpilot:leadpilot@localhost:5434/leadpilot?schema=public
