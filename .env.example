# VARSA — environment shape. Copy to .env.local and fill in real values.
# Never commit a file with real secrets.

# Database (PostgreSQL — Docker, Neon, Supabase, or local)
DATABASE_URL=

# Clerk auth
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/continue
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/continue

# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Lead data provider (Apollo → Settings → Integrations → API)
APOLLO_API_KEY=

# AI providers (fallback order: OpenAI → Groq → Gemini → Claude)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Static admin auth (separate from Clerk user login)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 32+ characters. Rotating this requires scripts/rotate-encryption-key.ts —
# existing ApiKeyConfig rows are encrypted with the current value.
ENCRYPTION_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
# Enforce subscription + monthly caps. Leave unset for local dev.
# BILLING_ENFORCE=true
# NEXT_PUBLIC_BILLING_ENFORCE=true

# People delivered per user-approved batch. One click, one batch (10–200).
LEAD_BATCH_SIZE=100

# Bearer secret for /api/cron/release-stale, which frees credit holds left by a
# batch that died mid-flight. The route refuses to run when this is unset.
CRON_SECRET=

# Save only provider-verified emails; guessed addresses bounce.
LEAD_REQUIRE_VERIFIED_EMAIL=true

# Lead quality floor and unlock behaviour
LEAD_MIN_SCORE=5
LEAD_REQUIRE_EMAIL=false
LEAD_UNLOCK_ATTEMPTS_PER_RUN=300
UNLOCK_BATCH_TIMEOUT_MS=180000
SEARCH_DEADLINE_MS=280000

# Provider pacing / AI limits
APOLLO_PER_PAGE=100
APOLLO_PAGE_DELAY_MS=120
APOLLO_ENRICH_BATCH_SIZE=25
APOLLO_ENRICH_CONCURRENCY=5
APOLLO_REVEAL_PERSONAL_EMAILS=true
AI_TIMEOUT_MS=30000
AI_MAX_SCORE_COUNT=40
AI_SCORE_BATCH_SIZE=20

# GitHub public activity token (optional, raises rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=
