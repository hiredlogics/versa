# LeadPilot AI — Environment Variables

# Database (PostgreSQL — Docker, Neon, Supabase, or local)
# Docker (recommended local): npm run db:up — then use .env.docker.example
# DATABASE_URL=postgresql://leadpilot:leadpilot@localhost:5434/leadpilot?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/cludly

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/continue
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/continue

# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Billing gate — set to true once Stripe keys + webhooks are configured.
# While unset/false, subscription checks and monthly lead/search limits are disabled for local dev.
# BILLING_ENFORCE=true
# NEXT_PUBLIC_BILLING_ENFORCE=true
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# Apollo (Apollo → Settings → Integrations → API)
APOLLO_API_KEY=your-apollo-api-key

# AI Providers (fallback order: OpenAI → Groq → Gemini → Claude)
OPENAI_API_KEY=
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...

# Security
ENCRYPTION_KEY=your-32-char-minimum-encryption-key-here

# Static admin auth (separate from Clerk user login)
ADMIN_EMAIL=admin@example.com
# ADMIN_EMAILS=admin1@example.com,admin2@example.com
ADMIN_PASSWORD=your-secure-admin-password
# ADMIN_SESSION_SECRET=optional-32-char-secret-for-admin-cookies

# Lead search limits
MIN_LEAD_SCORE=8
MAX_LEADS_PER_SEARCH=100
AI_TIMEOUT_MS=30000
SCORING_MODE=heuristic
AI_SCORE_BATCH_SIZE=20
APOLLO_SMART_RELAX=true
# true → paginate until Apollo's 50k display limit (one prompt = full pull)
APOLLO_FETCH_ALL=true
APOLLO_PER_PAGE=100
APOLLO_MAX_PAGES=0
APOLLO_PAGE_DELAY_MS=120
SEARCH_DEADLINE_MS=280000
# Page-level enrich cap (legacy / prepareLeadPage). Main job unlocks in sequential LEAD_PROCESS_BATCH_SIZE batches.
APOLLO_MAX_ENRICH=200
APOLLO_ENRICH_BATCH_SIZE=25
APOLLO_ENRICH_PAGE_CAP=200
APOLLO_ENRICH_CONCURRENCY=5
# Required to unlock emails from Apollo people/match + bulk_match
APOLLO_REVEAL_PERSONAL_EMAILS=true
# Sequential job batches: fetch → unlock → save (never unlock the whole pool at once)
# Also the credit-safe step size shown in the UI ("Get next 100").
LEAD_PROCESS_BATCH_SIZE=100
# Max auto batches per run (0 = unlimited). 1 → one batch per click; user asks for the next 100.
LEAD_MAX_AUTO_BATCHES=1
# Soft timeout for unlock within one batch (ms) — then save partial and continue/resume
UNLOCK_BATCH_TIMEOUT_MS=180000
# After unlock+filter, widen Apollo variants if fewer than this many have email
LEAD_MIN_WITH_EMAIL=10
# Prompt-only: do not blend onboarding ICP into Apollo filters
USE_LEAD_CONTEXT=false
# Save the full Apollo pull for a search (not truncated to monthly "credits remaining")
ALLOW_FULL_SEARCH_SAVE=true
# 0 = save every lead from the pull
LEAD_MAX_RESULTS=0
LEAD_RESPONSE_LIMIT=200
LEAD_MIN_SCORE=5
LEAD_REQUIRE_EMAIL=false
SCORING_MODE=heuristic
WHY_AI_MAX=100
AI_WHY_BATCH_SIZE=12
